{
  "name": "codefyphp/domain-driven-core",
  "type": "library",
  "description": "Libraries and Interfaces for domain driven design.",
  "keywords": [
    "ddd",
    "domaindrivendesign",
    "cqrs",
    "eventsourcing",
    "eventbus",
    "commandbus",
    "eventstore",
    "aggregateroot",
    "domainevents"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Joshua Parker",
      "email": "joshua@joshuaparker.dev"
    }
  ],
  "require": {
    "php": ">=8.4",
    "qubus/event-dispatcher": "^3",
    "qubus/exception": "^3",
    "qubus/injector": "^3",
    "qubus/valueobjects": "^3"
  },
  "require-dev": {
    "mockery/mockery": "^1.3.1",
    "pestphp/pest": "^3",
    "qubus/cache": "^3",
    "qubus/log": "^3",
    "qubus/qubus-coding-standard": "^1.1"
  },
  "autoload": {
    "exclude-from-classmap": ["/tests/"],
    "psr-4": {
      "Codefy\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codefy\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
